default_platform(:ios)

platform :ios do
  desc "Deploy a new build to TestFlight"
  lane :deploy_testflight do
    setup_ci

    # Install the App Store Connect API key
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: true,
    )

    # Install the distribution certificate
    import_certificate(
      certificate_path: "fastlane/certificate.p12",
      certificate_password: ENV["DISTRIBUTION_CERTIFICATE_PASSWORD"],
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: "",
    )

    # Install the provisioning profile
    install_provisioning_profile(path: "fastlane/profile.mobileprovision")

    # Get version from pubspec.yaml
    pubspec = File.read("../../pubspec.yaml")
    version = pubspec.match(/version:\s*(\S+)/)[1]
    version_name, build_number = version.split("+")

    # Build the Flutter IPA
    Dir.chdir("../..") do
      sh("flutter", "build", "ipa",
        "--release",
        "--dart-define=REVENUECAT_API_KEY=#{ENV['REVENUECAT_API_KEY']}",
        "--export-options-plist=ios/ExportOptions.plist",
      )
    end

    # Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      ipa: "../../build/ios/ipa/brainy.ipa",
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: ENV["CHANGELOG"] || "New build",
    )
  end
end
