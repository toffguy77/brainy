default_platform(:ios)

platform :ios do
  desc "Deploy a new build to TestFlight"
  lane :deploy_testflight do
    setup_ci

    # Install the App Store Connect API key
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: true,
    )

    # Metadata-only commits (e.g. new screenshots) re-trigger this lane with
    # the same build number: skip instead of failing on a duplicate upload.
    app_version, build_number = File.read(File.expand_path("../../pubspec.yaml", __dir__))
      .match(/^version:\s*([\d.]+)\+(\d+)/).captures
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.brainyapp.brainy",
      version: app_version,
      initial_build_number: 0,
    ).to_i
    if latest >= build_number.to_i
      UI.important("Build #{app_version} (#{build_number}) is already in TestFlight; skipping")
      next
    end

    # Install the distribution certificate
    import_certificate(
      certificate_path: "fastlane/certificate.p12",
      certificate_password: ENV["DISTRIBUTION_CERTIFICATE_PASSWORD"],
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: "",
    )

    # Install the provisioning profile and extract its UUID
    profile_path = install_provisioning_profile(path: "fastlane/profile.mobileprovision")
    profile_uuid = File.basename(profile_path, ".mobileprovision")
    UI.message("Provisioning profile UUID: #{profile_uuid}")

    # Switch to manual code signing for CI
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "3GWRDGA8B7",
      code_sign_identity: "Apple Distribution",
      profile_uuid: profile_uuid,
      bundle_identifier: "com.brainyapp.brainy",
    )

    # Build Flutter assets (no code signing — Fastlane handles that)
    Dir.chdir("../..") do
      sh("flutter", "build", "ios",
        "--release",
        "--no-codesign",
      )
    end

    # Read profile name from the installed provisioning profile
    installed_profile = File.join(
      Dir.home, "Library/Developer/Xcode/UserData/Provisioning Profiles",
      "#{profile_uuid}.mobileprovision"
    )
    profile_plist = sh("security", "cms", "-D", "-i", installed_profile, log: false)
    match_result = profile_plist.match(/<key>Name<\/key>\s*<string>(.*?)<\/string>/m)
    UI.user_error!("Could not extract profile name from provisioning profile") unless match_result
    profile_name = match_result[1]
    UI.message("Provisioning profile name: #{profile_name}")

    # Archive and export IPA with proper signing
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.brainyapp.brainy" => profile_name,
        },
      },
      output_directory: "../../build/ios/ipa",
      output_name: "brainy.ipa",
    )

    # Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      ipa: "../../build/ios/ipa/brainy.ipa",
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: ENV["CHANGELOG"] || "New build",
    )
  end

  desc "Upload metadata, screenshots and submit for App Store review"
  lane :submit_review do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: true,
    )

    deliver(
      api_key: api_key,
      app_identifier: "com.brainyapp.brainy",
      submit_for_review: true,
      automatic_release: true,
      force: true,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
      },
    )
  end

  desc "Full release: build, upload to TestFlight, wait for processing, deliver metadata, submit for review"
  lane :release do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: true,
    )

    # The live version cannot be edited: name the new App Store version and
    # the exact build explicitly, from pubspec.yaml ("1.2.0+16").
    app_version, build_number = File.read(File.expand_path("../../pubspec.yaml", __dir__))
      .match(/^version:\s*([\d.]+)\+(\d+)/).captures

    # Pushing to main already uploads this build via deploy_testflight. When it
    # is in TestFlight, skip straight to review instead of failing on a
    # duplicate upload.
    uploaded = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.brainyapp.brainy",
      version: app_version,
      initial_build_number: 0,
    ).to_i >= build_number.to_i

    unless uploaded
      import_certificate(
        certificate_path: "fastlane/certificate.p12",
        certificate_password: ENV["DISTRIBUTION_CERTIFICATE_PASSWORD"],
        keychain_name: "fastlane_tmp_keychain",
        keychain_password: "",
      )

      profile_path = install_provisioning_profile(path: "fastlane/profile.mobileprovision")
      profile_uuid = File.basename(profile_path, ".mobileprovision")

      update_code_signing_settings(
        use_automatic_signing: false,
        path: "Runner.xcodeproj",
        team_id: "3GWRDGA8B7",
        code_sign_identity: "Apple Distribution",
        profile_uuid: profile_uuid,
        bundle_identifier: "com.brainyapp.brainy",
      )

      Dir.chdir("../..") do
        sh("flutter", "build", "ios",
          "--release",
          "--no-codesign",
        )
      end

      installed_profile = File.join(
        Dir.home, "Library/Developer/Xcode/UserData/Provisioning Profiles",
        "#{profile_uuid}.mobileprovision"
      )
      profile_plist = sh("security", "cms", "-D", "-i", installed_profile, log: false)
      match_result = profile_plist.match(/<key>Name<\/key>\s*<string>(.*?)<\/string>/m)
      UI.user_error!("Could not extract profile name from provisioning profile") unless match_result
      profile_name = match_result[1]

      build_app(
        workspace: "Runner.xcworkspace",
        scheme: "Runner",
        export_method: "app-store",
        export_options: {
          provisioningProfiles: {
            "com.brainyapp.brainy" => profile_name,
          },
        },
        output_directory: "../../build/ios/ipa",
        output_name: "brainy.ipa",
      )

      upload_to_testflight(
        api_key: api_key,
        ipa: "../../build/ios/ipa/brainy.ipa",
        skip_waiting_for_build_processing: false,
        wait_for_uploaded_build: true,
        distribute_external: false,
        changelog: ENV["CHANGELOG"] || "New build",
      )
    end

    deliver(
      api_key: api_key,
      app_identifier: "com.brainyapp.brainy",
      app_version: app_version,
      build_number: build_number,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
      },
    )
  end
end
